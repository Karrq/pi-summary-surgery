{
  "name": "pi-summary-surgery",
  "version": "0.1.0",
  "type": "module",
  "description": "Summarize an explicitly marked range of a Pi session on a clean-context branch, in the same session.",
  "keywords": [
    "pi-package",
    "pi",
    "summary",
    "summarize",
    "session",
    "compaction"
  ],
  "license": "MIT",
  "author": "Francesco Dainese",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "extensions/summary/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "extensions",
    "docs",
    "README.md"
  ]
}
